{
  "schema": "mushafplus-warsh-translation-fr-v1",
  "edition": "fr.montada-warsh",
  "surah_number": 88,
  "number_of_ayahs": 26,
  "ayahs": [
    {
      "ayah_number": 1,
      "hafs_numbers": [
        1
      ],
      "text": "T’est-il parvenu la nouvelle de (la Journée) envahissante ?"
    },
    {
      "ayah_number": 2,
      "hafs_numbers": [
        2
      ],
      "text": "Des visages, ce jour-là, seront empreints d’humiliation,"
    },
    {
      "ayah_number": 3,
      "hafs_numbers": [
        3
      ],
      "text": "peinant, épuisés,"
    },
    {
      "ayah_number": 4,
      "hafs_numbers": [
        4
      ],
      "text": "qui brûleront dans un Feu très ardent,"
    },
    {
      "ayah_number": 5,
      "hafs_numbers": [
        5
      ],
      "text": "et boiront à une source d’eau bouillante."
    },
    {
      "ayah_number": 6,
      "hafs_numbers": [
        6
      ],
      "text": "Ils n’auront pour toute nourriture que du Dhari‘,",
      "footnotes": [
        {
          "ref": 604,
          "text": "Plante hérissée d’épines."
        }
      ]
    },
    {
      "ayah_number": 7,
      "hafs_numbers": [
        7
      ],
      "text": "qui n’engraissera point, ni ne calmera la faim."
    },
    {
      "ayah_number": 8,
      "hafs_numbers": [
        8
      ],
      "text": "Et il y aura, ce jour-là, des visages radieux,"
    },
    {
      "ayah_number": 9,
      "hafs_numbers": [
        9
      ],
      "text": "satisfaits de ce qu’ils auront accompli,"
    },
    {
      "ayah_number": 10,
      "hafs_numbers": [
        10
      ],
      "text": "dans des jardins surplombants,"
    },
    {
      "ayah_number": 11,
      "hafs_numbers": [
        11
      ],
      "text": "où il ne sera entendu aucune parole futile."
    },
    {
      "ayah_number": 12,
      "hafs_numbers": [
        12
      ],
      "text": "Il s’y trouvera une source qui coule,"
    },
    {
      "ayah_number": 13,
      "hafs_numbers": [
        13
      ],
      "text": "des lits y seront élevés,"
    },
    {
      "ayah_number": 14,
      "hafs_numbers": [
        14
      ],
      "text": "des coupes posées,"
    },
    {
      "ayah_number": 15,
      "hafs_numbers": [
        15
      ],
      "text": "des coussins bien disposés,"
    },
    {
      "ayah_number": 16,
      "hafs_numbers": [
        16
      ],
      "text": "et des tapis étendus."
    },
    {
      "ayah_number": 17,
      "hafs_numbers": [
        17
      ],
      "text": "Ne voient-ils donc pas comment les chameaux ont été créés ?"
    },
    {
      "ayah_number": 18,
      "hafs_numbers": [
        18
      ],
      "text": "Et comment le ciel a été élevé ?"
    },
    {
      "ayah_number": 19,
      "hafs_numbers": [
        19
      ],
      "text": "Et comment les montagnes ont été érigées ?"
    },
    {
      "ayah_number": 20,
      "hafs_numbers": [
        20
      ],
      "text": "Et comment la terre a été aplanie ?"
    },
    {
      "ayah_number": 21,
      "hafs_numbers": [
        21
      ],
      "text": "Rappelle donc ! Car tu es là pour rappeler !"
    },
    {
      "ayah_number": 22,
      "hafs_numbers": [
        22
      ],
      "text": "Tu n’as pas à les contraindre,"
    },
    {
      "ayah_number": 23,
      "hafs_numbers": [
        23
      ],
      "text": "mais celui-là seul qui se détourne et mécroit,"
    },
    {
      "ayah_number": 24,
      "hafs_numbers": [
        24
      ],
      "text": "Allah lui infligera le plus grand supplice."
    },
    {
      "ayah_number": 25,
      "hafs_numbers": [
        25
      ],
      "text": "C’est vers Nous, certes, que sera leur retour."
    },
    {
      "ayah_number": 26,
      "hafs_numbers": [
        26
      ],
      "text": "Puis c’est à Nous qu’il incombera de leur demander des comptes."
    }
  ]
}
