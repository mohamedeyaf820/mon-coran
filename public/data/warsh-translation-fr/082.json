{
  "schema": "mushafplus-warsh-translation-fr-v1",
  "edition": "fr.montada-warsh",
  "surah_number": 82,
  "number_of_ayahs": 19,
  "ayahs": [
    {
      "ayah_number": 1,
      "hafs_numbers": [
        1
      ],
      "text": "Quand le ciel se brisera,"
    },
    {
      "ayah_number": 2,
      "hafs_numbers": [
        2
      ],
      "text": "quand les astres choiront,"
    },
    {
      "ayah_number": 3,
      "hafs_numbers": [
        3
      ],
      "text": "que les mers se confondront,"
    },
    {
      "ayah_number": 4,
      "hafs_numbers": [
        4
      ],
      "text": "que les tombes seront renversées,"
    },
    {
      "ayah_number": 5,
      "hafs_numbers": [
        5
      ],
      "text": "chaque âme saura alors ce qu’elle a déjà fait et ce qu’elle a renvoyé à plus tard."
    },
    {
      "ayah_number": 6,
      "hafs_numbers": [
        6
      ],
      "text": "Ô homme ! Qu’est-ce qui t’a donc leurré au sujet de ton Noble Seigneur"
    },
    {
      "ayah_number": 7,
      "hafs_numbers": [
        7
      ],
      "text": "Qui t’a créé, t’a façonné et t’a donné des formes aussi proportionnées ?"
    },
    {
      "ayah_number": 8,
      "hafs_numbers": [
        8
      ],
      "text": "Il t’a constitué dans la forme qu’Il a voulue."
    },
    {
      "ayah_number": 9,
      "hafs_numbers": [
        9
      ],
      "text": "Et pourtant, vous tenez la Rétribution pour imposture."
    },
    {
      "ayah_number": 10,
      "hafs_numbers": [
        10
      ],
      "text": "Des gardiens sont là à vous surveiller,"
    },
    {
      "ayah_number": 11,
      "hafs_numbers": [
        11
      ],
      "text": "qui sont de nobles scripteurs,",
      "footnotes": [
        {
          "ref": 597,
          "text": "Sur le choix de ce mot, au lieu de « scribe » ou « écrivain », voir la note 105."
        }
      ]
    },
    {
      "ayah_number": 12,
      "hafs_numbers": [
        12
      ],
      "text": "sachant bien ce que vous faites."
    },
    {
      "ayah_number": 13,
      "hafs_numbers": [
        13
      ],
      "text": "Les vertueux auront droit au délice absolu."
    },
    {
      "ayah_number": 14,
      "hafs_numbers": [
        14
      ],
      "text": "Les scélérats seront en Enfer."
    },
    {
      "ayah_number": 15,
      "hafs_numbers": [
        15
      ],
      "text": "Ils y brûleront au Jour de la Rétribution,"
    },
    {
      "ayah_number": 16,
      "hafs_numbers": [
        16
      ],
      "text": "et ne pourront s’y dérober."
    },
    {
      "ayah_number": 17,
      "hafs_numbers": [
        17
      ],
      "text": "Et qui te fera jamais savoir ce qu’est le Jour de la Rétribution ?"
    },
    {
      "ayah_number": 18,
      "hafs_numbers": [
        18
      ],
      "text": "Et puis, qui te fera jamais savoir ce qu’est le Jour de la Rétribution ?"
    },
    {
      "ayah_number": 19,
      "hafs_numbers": [
        19
      ],
      "text": "C’est le jour où aucune âme ne pourra rien pour une autre âme. Et la décision, ce jour-là, reviendra entière à Allah."
    }
  ]
}
