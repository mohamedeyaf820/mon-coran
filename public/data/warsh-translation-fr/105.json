{
  "schema": "mushafplus-warsh-translation-fr-v1",
  "edition": "fr.montada-warsh",
  "surah_number": 105,
  "number_of_ayahs": 5,
  "ayahs": [
    {
      "ayah_number": 1,
      "hafs_numbers": [
        1
      ],
      "text": "N’as-tu pas vu ce que fit ton Seigneur aux compagnons de l’Éléphant ?"
    },
    {
      "ayah_number": 2,
      "hafs_numbers": [
        2
      ],
      "text": "N’a-t-Il pas déjoué leurs intrigues,"
    },
    {
      "ayah_number": 3,
      "hafs_numbers": [
        3
      ],
      "text": "en leur envoyant des nuées d’oiseaux,"
    },
    {
      "ayah_number": 4,
      "hafs_numbers": [
        4
      ],
      "text": "qui leur lançaient des pierres argileuses ?"
    },
    {
      "ayah_number": 5,
      "hafs_numbers": [
        5
      ],
      "text": "Il les rendit telles des brindilles mâchées (et recrachées.)."
    }
  ]
}
