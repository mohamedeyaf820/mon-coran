{
  "schema": "mushafplus-warsh-translation-fr-v1",
  "edition": "fr.montada-warsh",
  "surah_number": 104,
  "number_of_ayahs": 9,
  "ayahs": [
    {
      "ayah_number": 1,
      "hafs_numbers": [
        1
      ],
      "text": "Malheur à tout calomniateur, diffamateur,"
    },
    {
      "ayah_number": 2,
      "hafs_numbers": [
        2
      ],
      "text": "qui amasse les biens et ne laisse pas de les compter,"
    },
    {
      "ayah_number": 3,
      "hafs_numbers": [
        3
      ],
      "text": "pensant que ses biens le rendront éternel."
    },
    {
      "ayah_number": 4,
      "hafs_numbers": [
        4
      ],
      "text": "Que non ! Il sera précipité dans la Ḥutamah.",
      "footnotes": [
        {
          "ref": 618,
          "text": "Du trilitère arabe « ḥatama » : détruire, briser. La Ḥutamah est l’un des noms de l’Enfer : tout ce qui y est précipité est, justement, brisé."
        }
      ]
    },
    {
      "ayah_number": 5,
      "hafs_numbers": [
        5
      ],
      "text": "Et qui te fera jamais savoir ce qu’est la Ḥutamah ?"
    },
    {
      "ayah_number": 6,
      "hafs_numbers": [
        6
      ],
      "text": "C’est le Feu d’Allah, à jamais attisé,"
    },
    {
      "ayah_number": 7,
      "hafs_numbers": [
        7
      ],
      "text": "qui atteindra les cœurs."
    },
    {
      "ayah_number": 8,
      "hafs_numbers": [
        8
      ],
      "text": "Sur eux il se refermera"
    },
    {
      "ayah_number": 9,
      "hafs_numbers": [
        9
      ],
      "text": "et s’étendra par colonnes."
    }
  ]
}
