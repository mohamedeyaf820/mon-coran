{
  "schema": "mushafplus-warsh-translation-fr-v1",
  "edition": "fr.montada-warsh",
  "surah_number": 95,
  "number_of_ayahs": 8,
  "ayahs": [
    {
      "ayah_number": 1,
      "hafs_numbers": [
        1
      ],
      "text": "Par le figuier et l’olivier !"
    },
    {
      "ayah_number": 2,
      "hafs_numbers": [
        2
      ],
      "text": "Par le mont Sinaï !"
    },
    {
      "ayah_number": 3,
      "hafs_numbers": [
        3
      ],
      "text": "Par cette cité si sûre !",
      "footnotes": [
        {
          "ref": 612,
          "text": "Il s’agit de La Mecque."
        }
      ]
    },
    {
      "ayah_number": 4,
      "hafs_numbers": [
        4
      ],
      "text": "Nous avons créé l’homme dans la meilleure forme qui soit."
    },
    {
      "ayah_number": 5,
      "hafs_numbers": [
        5
      ],
      "text": "Puis Nous l’avons fait choir au rang le plus bas,"
    },
    {
      "ayah_number": 6,
      "hafs_numbers": [
        6
      ],
      "text": "sauf ceux qui ont cru et accompli les bonnes œuvres, qui, eux, auront une récompense inépuisable."
    },
    {
      "ayah_number": 7,
      "hafs_numbers": [
        7
      ],
      "text": "Qu’est-ce qui te pousse (ô homme), après cela, à prendre pour un mensonge la Rétribution?"
    },
    {
      "ayah_number": 8,
      "hafs_numbers": [
        8
      ],
      "text": "Allah n’est-Il pas le plus Sage des juges ?"
    }
  ]
}
