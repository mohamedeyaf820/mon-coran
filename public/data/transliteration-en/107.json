{
  "schema": "mushafplus-transliteration-en-hafs-v1",
  "edition": "en.qurancom-wordbyword",
  "surah_number": 107,
  "number_of_ayahs": 7,
  "ayahs": [
    {
      "ayah_number": 1,
      "text": "ara-ayta alladhī yukadhibu bil-dīni"
    },
    {
      "ayah_number": 2,
      "text": "fadhālika alladhī yaduʿʿu l-yatīma"
    },
    {
      "ayah_number": 3,
      "text": "walā yaḥuḍḍu ʿalā ṭaʿāmi l-mis'kīni"
    },
    {
      "ayah_number": 4,
      "text": "fawaylun lil'muṣallīna"
    },
    {
      "ayah_number": 5,
      "text": "alladhīna hum ʿan ṣalātihim sāhūna"
    },
    {
      "ayah_number": 6,
      "text": "alladhīna hum yurāūna"
    },
    {
      "ayah_number": 7,
      "text": "wayamnaʿūna l-māʿūna"
    }
  ]
}
