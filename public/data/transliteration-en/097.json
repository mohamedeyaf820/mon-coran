  "surah_number": 97,
  "number_of_ayahs": 5,
  "ayahs": [
    {
      "ayah_number": 1,
      "text": "innā anzalnāhu fī laylati l-qadri"
    },
    {
      "ayah_number": 2,
      "text": "wamā adrāka mā laylatu l-qadri"
    },
    {
      "ayah_number": 3,
      "text": "laylatu l-qadri khayrun min alfi shahrin"
    },
    {
      "ayah_number": 4,
      "text": "tanazzalu l-malāikatu wal-rūḥu fīhā bi-idh'ni rabbihim min kulli amrin"
    },
    {
      "ayah_number": 5,
      "text": "salāmun hiya ḥattā maṭlaʿi l-fajri"
    }
  ]
}
