{
  "schema": "mushafplus-transliteration-en-hafs-v1",
  "edition": "en.qurancom-wordbyword",
  "surah_number": 74,
  "number_of_ayahs": 56,
  "ayahs": [
    {
      "ayah_number": 1,
      "text": "yāayyuhā l-mudathiru"
    },
    {
      "ayah_number": 2,
      "text": "qum fa-andhir"
    },
    {
      "ayah_number": 3,
      "text": "warabbaka fakabbir"
    },
    {
      "ayah_number": 4,
      "text": "wathiyābaka faṭahhir"
    },
    {
      "ayah_number": 5,
      "text": "wal-ruj'za fa-uh'jur"
    },
    {
      "ayah_number": 6,
      "text": "walā tamnun tastakthiru"
    },
    {
      "ayah_number": 7,
      "text": "walirabbika fa-iṣ'bir"
    },
    {
      "ayah_number": 8,
      "text": "fa-idhā nuqira fī l-nāqūri"
    },
    {
      "ayah_number": 9,
      "text": "fadhālika yawma-idhin yawmun ʿasīrun"
    },
    {
      "ayah_number": 10,
      "text": "ʿalā l-kāfirīna ghayru yasīrin"
    },
    {
      "ayah_number": 11,
      "text": "dharnī waman khalaqtu waḥīdan"
    },
    {
      "ayah_number": 12,
      "text": "wajaʿaltu lahu mālan mamdūdan"
    },
    {
      "ayah_number": 13,
      "text": "wabanīna shuhūdan"
    },
    {
      "ayah_number": 14,
      "text": "wamahhadttu lahu tamhīdan"
    },
    {
      "ayah_number": 15,
      "text": "thumma yaṭmaʿu an azīda"
    },
    {
      "ayah_number": 16,
      "text": "kallā innahu kāna liāyātinā ʿanīdan"
    },
    {
      "ayah_number": 17,
      "text": "sa-ur'hiquhu ṣaʿūdan"
    },
    {
      "ayah_number": 18,
      "text": "innahu fakkara waqaddara"
    },
    {
      "ayah_number": 19,
      "text": "faqutila kayfa qaddara"
    },
    {
      "ayah_number": 20,
      "text": "thumma qutila kayfa qaddara"
    },
    {
      "ayah_number": 21,
      "text": "thumma naẓara"
    },
    {
      "ayah_number": 22,
      "text": "thumma ʿabasa wabasara"
    },
    {
      "ayah_number": 23,
      "text": "thumma adbara wa-is'takbara"
    },
    {
      "ayah_number": 24,
      "text": "faqāla in hādhā illā siḥ'run yu'tharu"
    },
    {
      "ayah_number": 25,
      "text": "in hādhā illā qawlu l-bashari"
    },
    {
      "ayah_number": 26,
      "text": "sa-uṣ'līhi saqara"
    },
    {
      "ayah_number": 27,
      "text": "wamā adrāka mā saqaru"
    },
    {
      "ayah_number": 28,
      "text": "lā tub'qī walā tadharu"
    },
    {
      "ayah_number": 29,
      "text": "lawwāḥatun lil'bashari"
    },
    {
      "ayah_number": 30,
      "text": "ʿalayhā tis'ʿata ʿashara"
    },
    {
      "ayah_number": 31,
      "text": "wamā jaʿalnā aṣḥāba l-nāri illā malāikatan wamā jaʿalnā ʿiddatahum illā fit'natan lilladhīna kafarū liyastayqina alladhīna ūtū l-kitāba wayazdāda alladhīna āmanū īmānan walā yartāba alladhīna ūtū l-kitāba wal-mu'minūna waliyaqūla alladhīna fī qulūbihim maraḍun wal-kāfirūna mādhā arāda l-lahu bihādhā mathalan kadhālika yuḍillu l-lahu man yashāu wayahdī man yashāu wamā yaʿlamu junūda rabbika illā huwa wamā hiya illā dhik'rā lil'bashari"
    },
    {
      "ayah_number": 32,
      "text": "kallā wal-qamari"
    },
    {
      "ayah_number": 33,
      "text": "wa-al-layli idh adbara"
    },
    {
      "ayah_number": 34,
      "text": "wal-ṣub'ḥi idhā asfara"
    },
    {
      "ayah_number": 35,
      "text": "innahā la-iḥ'dā l-kubari"
    },
    {
      "ayah_number": 36,
      "text": "nadhīran lil'bashari"
    },
    {
      "ayah_number": 37,
      "text": "liman shāa minkum an yataqaddama aw yata-akhara"
    },
    {
      "ayah_number": 38,
      "text": "kullu nafsin bimā kasabat rahīnatun"
    },
    {
      "ayah_number": 39,
      "text": "illā aṣḥāba l-yamīni"
    },
    {
      "ayah_number": 40,
      "text": "fī jannātin yatasāalūna"
    },
    {
      "ayah_number": 41,
      "text": "ʿani l-muj'rimīna"
    },
    {
      "ayah_number": 42,
      "text": "mā salakakum fī saqara"
    },
    {
      "ayah_number": 43,
      "text": "qālū lam naku mina l-muṣalīna"
    },
    {
      "ayah_number": 44,
      "text": "walam naku nuṭ'ʿimu l-mis'kīna"
    },
    {
      "ayah_number": 45,
      "text": "wakunnā nakhūḍu maʿa l-khāiḍīna"
    },
    {
      "ayah_number": 46,
      "text": "wakunnā nukadhibu biyawmi l-dīni"
    },
    {
      "ayah_number": 47,
      "text": "ḥattā atānā l-yaqīnu"
    },
    {
      "ayah_number": 48,
      "text": "famā tanfaʿuhum shafāʿatu l-shāfiʿīna"
    },
    {
      "ayah_number": 49,
      "text": "famā lahum ʿani l-tadhkirati muʿ'riḍīna"
    },
    {
      "ayah_number": 50,
      "text": "ka-annahum ḥumurun mus'tanfiratun"
    },
    {
      "ayah_number": 51,
      "text": "farrat min qaswaratin"
    },
    {
      "ayah_number": 52,
      "text": "bal yurīdu kullu im'ri-in min'hum an yu'tā ṣuḥufan munasharatan"
    },
    {
      "ayah_number": 53,
      "text": "kallā bal lā yakhāfūna l-ākhirata"
    },
    {
      "ayah_number": 54,
      "text": "kallā innahu tadhkiratun"
    },
    {
      "ayah_number": 55,
      "text": "faman shāa dhakarahu"
    },
    {
      "ayah_number": 56,
      "text": "wamā yadhkurūna illā an yashāa l-lahu huwa ahlu l-taqwā wa-ahlu l-maghfirati"
    }
  ]
}
