  "ayahs": [
    {
      "ayah_number": 1,
      "text": "qul aʿūdhu birabbi l-falaqi"
    },
    {
      "ayah_number": 2,
      "text": "min sharri mā khalaqa"
    },
    {
      "ayah_number": 3,
      "text": "wamin sharri ghāsiqin idhā waqaba"
    },
    {
      "ayah_number": 4,
      "text": "wamin sharri l-nafāthāti fī l-ʿuqadi"
    },
    {
      "ayah_number": 5,
      "text": "wamin sharri ḥāsidin idhā ḥasada"
    }
