{
  "schema": "mushafplus-transliteration-en-hafs-v1",
  "edition": "en.qurancom-wordbyword",
  "surah_number": 77,
  "number_of_ayahs": 50,
  "ayahs": [
    {
      "ayah_number": 1,
      "text": "wal-mur'salāti ʿur'fan"
    },
    {
      "ayah_number": 2,
      "text": "fal-ʿāṣifāti ʿaṣfan"
    },
    {
      "ayah_number": 3,
      "text": "wal-nāshirāti nashran"
    },
    {
      "ayah_number": 4,
      "text": "fal-fāriqāti farqan"
    },
    {
      "ayah_number": 5,
      "text": "fal-mul'qiyāti dhik'ran"
    },
    {
      "ayah_number": 6,
      "text": "ʿudh'ran aw nudh'ran"
    },
    {
      "ayah_number": 7,
      "text": "innamā tūʿadūna lawāqiʿun"
    },
    {
      "ayah_number": 8,
      "text": "fa-idhā l-nujūmu ṭumisat"
    },
    {
      "ayah_number": 9,
      "text": "wa-idhā l-samāu furijat"
    },
    {
      "ayah_number": 10,
      "text": "wa-idhā l-jibālu nusifat"
    },
    {
      "ayah_number": 11,
      "text": "wa-idhā l-rusulu uqqitat"
    },
    {
      "ayah_number": 12,
      "text": "li-ayyi yawmin ujjilat"
    },
    {
      "ayah_number": 13,
      "text": "liyawmi l-faṣli"
    },
    {
      "ayah_number": 14,
      "text": "wamā adrāka mā yawmu l-faṣli"
    },
    {
      "ayah_number": 15,
      "text": "waylun yawma-idhin lil'mukadhibīna"
    },
    {
      "ayah_number": 16,
      "text": "alam nuh'liki l-awalīna"
    },
    {
      "ayah_number": 17,
      "text": "thumma nut'biʿuhumu l-ākhirīna"
    },
    {
      "ayah_number": 18,
      "text": "kadhālika nafʿalu bil-muj'rimīna"
    },
    {
      "ayah_number": 19,
      "text": "waylun yawma-idhin lil'mukadhibīna"
    },
    {
      "ayah_number": 20,
      "text": "alam nakhluqkkum min māin mahīnin"
    },
    {
      "ayah_number": 21,
      "text": "fajaʿalnāhu fī qarārin makīnin"
    },
    {
      "ayah_number": 22,
      "text": "ilā qadarin maʿlūmin"
    },
    {
      "ayah_number": 23,
      "text": "faqadarnā faniʿ'ma l-qādirūna"
    },
    {
      "ayah_number": 24,
      "text": "waylun yawma-idhin lil'mukadhibīna"
    },
    {
      "ayah_number": 25,
      "text": "alam najʿali l-arḍa kifātan"
    },
    {
      "ayah_number": 26,
      "text": "aḥyāan wa-amwātan"
    },
    {
      "ayah_number": 27,
      "text": "wajaʿalnā fīhā rawāsiya shāmikhātin wa-asqaynākum māan furātan"
    },
    {
      "ayah_number": 28,
      "text": "waylun yawma-idhin lil'mukadhibīna"
    },
    {
      "ayah_number": 29,
      "text": "inṭaliqū ilā mā kuntum bihi tukadhibūna"
    },
    {
      "ayah_number": 30,
      "text": "inṭaliqū ilā ẓillin dhī thalāthi shuʿabin"
    },
    {
      "ayah_number": 31,
      "text": "lā ẓalīlin walā yugh'nī mina l-lahabi"
    },
    {
      "ayah_number": 32,
      "text": "innahā tarmī bishararin kal-qaṣri"
    },
    {
      "ayah_number": 33,
      "text": "ka-annahu jimālatun ṣuf'run"
    },
    {
      "ayah_number": 34,
      "text": "waylun yawma-idhin lil'mukadhibīna"
    },
    {
      "ayah_number": 35,
      "text": "hādhā yawmu lā yanṭiqūna"
    },
    {
      "ayah_number": 36,
      "text": "walā yu'dhanu lahum fayaʿtadhirūna"
    },
    {
      "ayah_number": 37,
      "text": "waylun yawma-idhin lil'mukadhibīna"
    },
    {
      "ayah_number": 38,
      "text": "hādhā yawmu l-faṣli jamaʿnākum wal-awalīna"
    },
    {
      "ayah_number": 39,
      "text": "fa-in kāna lakum kaydun fakīdūni"
    },
    {
      "ayah_number": 40,
      "text": "waylun yawma-idhin lil'mukadhibīna"
    },
    {
      "ayah_number": 41,
      "text": "inna l-mutaqīna fī ẓilālin waʿuyūnin"
    },
    {
      "ayah_number": 42,
      "text": "wafawākiha mimmā yashtahūna"
    },
    {
      "ayah_number": 43,
      "text": "kulū wa-ish'rabū hanīan bimā kuntum taʿmalūna"
    },
    {
      "ayah_number": 44,
      "text": "innā kadhālika najzī l-muḥ'sinīna"
    },
    {
      "ayah_number": 45,
      "text": "waylun yawma-idhin lil'mukadhibīna"
    },
    {
      "ayah_number": 46,
      "text": "kulū watamattaʿū qalīlan innakum muj'rimūna"
    },
    {
      "ayah_number": 47,
      "text": "waylun yawma-idhin lil'mukadhibīna"
    },
    {
      "ayah_number": 48,
      "text": "wa-idhā qīla lahumu ir'kaʿū lā yarkaʿūna"
    },
    {
      "ayah_number": 49,
      "text": "waylun yawma-idhin lil'mukadhibīna"
    },
    {
      "ayah_number": 50,
      "text": "fabi-ayyi ḥadīthin baʿdahu yu'minūna"
    }
  ]
}
