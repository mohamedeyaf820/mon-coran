{
  "schema": "mushafplus-warsh-translation-en-v1",
  "edition": "en.pickthall-warsh",
  "surah_number": 104,
  "number_of_ayahs": 9,
  "ayahs": [
    {
      "ayah_number": 1,
      "hafs_numbers": [
        1
      ],
      "text": "Woe unto every slandering traducer,"
    },
    {
      "ayah_number": 2,
      "hafs_numbers": [
        2
      ],
      "text": "Who hath gathered wealth (of this world) and arranged it."
    },
    {
      "ayah_number": 3,
      "hafs_numbers": [
        3
      ],
      "text": "He thinketh that his wealth will render him immortal."
    },
    {
      "ayah_number": 4,
      "hafs_numbers": [
        4
      ],
      "text": "Nay, but verily he will be flung to the Consuming One."
    },
    {
      "ayah_number": 5,
      "hafs_numbers": [
        5
      ],
      "text": "Ah, what will convey unto thee what the Consuming One is!"
    },
    {
      "ayah_number": 6,
      "hafs_numbers": [
        6
      ],
      "text": "(It is) the fire of Allah, kindled,"
    },
    {
      "ayah_number": 7,
      "hafs_numbers": [
        7
      ],
      "text": "Which leapeth up over the hearts (of men)."
    },
    {
      "ayah_number": 8,
      "hafs_numbers": [
        8
      ],
      "text": "Lo! it is closed in on them"
    },
    {
      "ayah_number": 9,
      "hafs_numbers": [
        9
      ],
      "text": "In outstretched columns."
    }
  ]
}
