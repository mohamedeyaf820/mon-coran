{
  "schema": "mushafplus-warsh-translation-en-v1",
  "edition": "en.pickthall-warsh",
  "surah_number": 86,
  "number_of_ayahs": 17,
  "ayahs": [
    {
      "ayah_number": 1,
      "hafs_numbers": [
        1
      ],
      "text": "By the heaven and the Morning Star"
    },
    {
      "ayah_number": 2,
      "hafs_numbers": [
        2
      ],
      "text": "- Ah, what will tell thee what the Morning Star is!"
    },
    {
      "ayah_number": 3,
      "hafs_numbers": [
        3
      ],
      "text": "- The piercing Star!"
    },
    {
      "ayah_number": 4,
      "hafs_numbers": [
        4
      ],
      "text": "No human soul but hath a guardian over it."
    },
    {
      "ayah_number": 5,
      "hafs_numbers": [
        5
      ],
      "text": "So let man consider from what he is created."
    },
    {
      "ayah_number": 6,
      "hafs_numbers": [
        6
      ],
      "text": "He is created from a gushing fluid"
    },
    {
      "ayah_number": 7,
      "hafs_numbers": [
        7
      ],
      "text": "That issued from between the loins and ribs."
    },
    {
      "ayah_number": 8,
      "hafs_numbers": [
        8
      ],
      "text": "Lo! He verily is Able to return him (unto life)"
    },
    {
      "ayah_number": 9,
      "hafs_numbers": [
        9
      ],
      "text": "On the day when hidden thoughts shall be searched out."
    },
    {
      "ayah_number": 10,
      "hafs_numbers": [
        10
      ],
      "text": "Then will he have no might nor any helper."
    },
    {
      "ayah_number": 11,
      "hafs_numbers": [
        11
      ],
      "text": "By the heaven which giveth the returning rain,"
    },
    {
      "ayah_number": 12,
      "hafs_numbers": [
        12
      ],
      "text": "And the earth which splitteth (with the growth of trees and plants)"
    },
    {
      "ayah_number": 13,
      "hafs_numbers": [
        13
      ],
      "text": "Lo! this (Qur'an) is a conclusive word,"
    },
    {
      "ayah_number": 14,
      "hafs_numbers": [
        14
      ],
      "text": "It is no pleasantry."
    },
    {
      "ayah_number": 15,
      "hafs_numbers": [
        15
      ],
      "text": "Lo! they plot a plot (against thee, O Muhammad)"
    },
    {
      "ayah_number": 16,
      "hafs_numbers": [
        16
      ],
      "text": "And I plot a plot (against them)."
    },
    {
      "ayah_number": 17,
      "hafs_numbers": [
        17
      ],
      "text": "So give a respite to the disbelievers. Deal thou gently with them for a while."
    }
  ]
}
