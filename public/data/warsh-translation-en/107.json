  "ayahs": [
    {
      "ayah_number": 1,
      "hafs_numbers": [
        1
      ],
      "text": "Hast thou observed him who belieth religion?"
    },
    {
      "ayah_number": 2,
      "hafs_numbers": [
        2
      ],
      "text": "That is he who repelleth the orphan,"
    },
    {
      "ayah_number": 3,
      "hafs_numbers": [
        3
      ],
      "text": "And urgeth not the feeding of the needy."
    },
    {
      "ayah_number": 4,
      "hafs_numbers": [
        4
      ],
      "text": "Ah, woe unto worshippers"
    },
    {
      "ayah_number": 5,
      "hafs_numbers": [
        5
      ],
      "text": "Who are heedless of their prayer;"
    },
    {
      "ayah_number": 6,
      "hafs_numbers": [
        6,
        7
      ],
      "text": "Who would be seen (at worship) Yet refuse small kindnesses!"
    }
  ]
}
