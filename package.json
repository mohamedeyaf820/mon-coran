{
  "name": "mushafplus",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/generate-shell-manifest.mjs && node scripts/purge-css.mjs && node scripts/generate-seo-pages.mjs && node scripts/audit-performance.mjs",
    "build:ci": "vite build && node scripts/generate-shell-manifest.mjs && node scripts/purge-css.mjs && node scripts/generate-seo-pages.mjs && node scripts/audit-performance.mjs && node scripts/check-screen-budget.mjs && node scripts/check-bundle-budget.mjs && node scripts/audit-css-architecture.mjs --check && node scripts/check-security-headers.mjs",
    "preview": "vite preview",
    "perf:budget": "node scripts/check-bundle-budget.mjs",
    "audit:css": "node scripts/audit-css-architecture.mjs",
    "audit:css:ci": "node scripts/audit-css-architecture.mjs --check",
    "audit:screen-budget": "node scripts/check-screen-budget.mjs",
    "test:security": "node --test tests/*.test.mjs",
    "test:coverage": "node --experimental-test-coverage --test tests/*.test.mjs",
    "lint": "eslint . --quiet --cache --cache-location node_modules/.cache/eslint",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test tests/e2e/audio-fallback.spec.mjs tests/e2e/a11y-smoke.spec.mjs",
    "test:e2e:audio": "playwright test tests/e2e/audio-fallback.spec.mjs",
    "test:e2e:visual": "playwright test tests/e2e/visual-debug.spec.mjs --config=playwright.debug.config.mjs --headed",
    "test:e2e:a11y": "playwright test tests/e2e/a11y-smoke.spec.mjs",
    "test:e2e:axe": "playwright test tests/e2e/axe-accessibility.spec.mjs --project=chromium",
    "test:e2e:compat": "playwright test tests/e2e/cross-browser-smoke.spec.mjs --project=firefox --project=webkit",
    "test:e2e:regression": "playwright test tests/e2e/visual-regression.spec.mjs --project=chromium",
    "pwa:screenshots": "node scripts/capture-pwa-screenshots.mjs",
    "test:e2e:reading": "playwright test tests/e2e/reading-scroll.spec.mjs tests/e2e/reading-stability.spec.mjs",
    "test:e2e:responsive": "playwright test tests/e2e/responsive-density.spec.mjs",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:warsh": "playwright test tests/e2e/warsh-debug.spec.mjs --config=playwright.debug.config.mjs --headed",
    "qa:smoke": "npm run test:e2e:smoke && npm run test:e2e:reading && npm run test:security",
    "csp:dev": "node scripts/print-csp.mjs development",
    "csp:prod": "node scripts/print-csp.mjs production",
    "audit:headers": "node scripts/check-security-headers.mjs",
    "audit:warsh:audio": "node scripts/audit-warsh-audio.mjs",
    "audit:warsh:tajweed": "node scripts/verify-warsh-tajweed.mjs",
    "audit:warsh": "npm run audit:warsh:tajweed && npm run audit:warsh:audio",
    "audit:reciters": "node scripts/audit-reciter-audio.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "idb": "^8.0.0",
    "lucide-react": "^0.576.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@fullhuman/postcss-purgecss": "^8.0.0",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@xmldom/xmldom": "^0.9.10",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "glob": "^13.0.6",
    "globals": "^17.7.0",
    "playwright": "^1.59.1",
    "postcss": "^8.5.19",
    "purgecss": "^8.0.0",
    "tailwindcss": "^4.2.1",
    "vite": "^8.0.16"
  }
}
