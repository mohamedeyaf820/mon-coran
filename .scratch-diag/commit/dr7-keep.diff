+/* The home header's centre cell is 117px wide at 280px (44px menu + 90px of
+   riwaya/more controls leave nothing else), while "Reprendre la lecture"
+   measures 129px: the nowrap+ellipsis contract showed "Reprendre la lectur…".
+   Letting it wrap costs one 14px line inside the untouched 44px touch target
+   and keeps every control reachable, so the label stays readable instead of
+   silently truncated. Arabic already fits on one line at these widths. */
+@media (max-width: 320px) {
+  html body .app-root > .mp-header .mp-header__home-summary-clean {
+    white-space: normal !important;
+    overflow: visible !important;
+    line-height: 1.15 !important;
+    text-align: center !important;
+  }
+}
