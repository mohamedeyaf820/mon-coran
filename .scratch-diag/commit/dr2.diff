@@ -861,11 +862,14 @@ html body .app-root > .mp-header .mp-header__title-sub-track {
 }
 
-/* Phones: replace the rotating title cycle with the static compact lockup. */
+/* Phones: the static compact lockup replaces the rotating cycle, which reads as
+   duplicated text at this width. Both changes are guarded by `:has()` because
+   the compact markup is not rendered by every build: hiding the cycle with no
+   replacement left the surah title at zero height from 280 to 640px, and
+   relaxing the stack height lets the 104px cycle track set the header height.
+   A browser without `:has()` drops these two rules and keeps the rotating
+   cycle, which is the legible direction to fail in. */
 @media (max-width: 640px) {
-  html body .app-root > .mp-header .mp-header__title-cycle-viewport {
-    display: none !important;
-  }
-
-  html body .app-root > .mp-header .mp-header__title-stack {
+  html body .app-root > .mp-header
+    .mp-header__title-stack:has(.mp-header__title-compact) {
     height: auto !important;
     max-height: none !important;
@@ -873,4 +877,10 @@ html body .app-root > .mp-header .mp-header__title-sub-track {
   }
 
+  html body .app-root > .mp-header
+    .mp-header__title-stack:has(.mp-header__title-compact)
+    .mp-header__title-cycle-viewport {
+    display: none !important;
+  }
+
   html body .app-root > .mp-header .mp-header__title-compact {
     display: flex;
@@ -1276,6 +1286,9 @@ html body #root .app-root[data-view="reading"] .quran-display--platform
 }
 
+/* Each verse is wrapped in its own `.virtualized-item`, so every card is a
+   `:last-child` of its wrapper. Selecting the stream's last item is the only
+   way to reach the genuinely final verse. */
 html body #root .app-root[data-view="reading"] .quran-display--platform
-  .qc-list-card.qc-list-card:last-child {
+  .qc-verse-by-verse-view > .virtualized-item:last-child .qc-list-card {
   border-bottom: 0 !important;
 }
