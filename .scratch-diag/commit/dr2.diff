 html body #root .app-root[data-view="reading"] .quran-display--platform
   .qc-list-card__top .ayah-actions button {
@@ -1298,4 +1309,17 @@ html body #root .app-root[data-view="reading"] .quran-display--platform
 }
 
+/* The reference is a text target ("2:253"), not an icon: a 44px square with no
+   padding pressed the digits against both edges. Keep the 44px touch floor and
+   let the box grow with the number of digits. */
+html body #root .app-root[data-view="reading"] .quran-display--platform
+  .qc-list-card__reference.qc-list-card__reference {
+  width: auto !important;
+  min-width: 44px !important;
+  height: 44px !important;
+  min-height: 44px !important;
+  padding-inline: 0.3rem !important;
+  border-radius: 0.72rem !important;
+}
+
 html body #root .app-root[data-view="reading"] .quran-display--platform
   .qc-list-card__top .ayah-actions button svg {
@@ -1320,10 +1344,30 @@ html body #root .app-root[data-view="reading"] .quran-display--platform
 }
 
+/* In the French/English reader the Arabic must share the left edge with its
+   transliteration and translation; a verse reads as three disconnected
+   fragments when the Arabic is pinned to the opposite edge of a wide column.
+   `match-parent` cannot express this because the Arabic keeps direction:rtl for
+   correct bidi, and `[dir=…]` selectors are dropped by the production CSS
+   build, so the card carries the reading direction as a data attribute. */
+html body #root .app-root[data-view="reading"] .quran-display--platform
+  .qc-list-card[data-verse-dir="ltr"] .qc-ayah-text-ar {
+  text-align: left !important;
+}
+
+/* A verse is one group: the three lines stay close together and only the
+   boundary between verses gets air. Without this, the transliteration and the
+   translation were spaced like separate verses. */
+html body #root .app-root[data-view="reading"] .quran-display--platform
+  .qc-list-card .qc-ayah-transliteration {
+  margin-block: 0.25rem 0 !important;
+  padding-block: 0 !important;
+}
+
 html body #root .app-root[data-view="reading"] .quran-display--platform
   .qc-list-card__translation-slot {
   min-height: 0 !important;
-  margin-top: 0.6rem !important;
-  padding-top: 0.7rem;
-  border-top: 1px solid color-mix(in srgb, var(--border) 76%, transparent);
+  margin-top: 0.35rem !important;
+  padding-top: 0 !important;
+  max-width: 72ch;
 }
 
@@ -1701,5 +1745,5 @@ html body #root .app-root[data-view="reading"] .quran-display--platform
     width: min(calc(100% - 1rem), 480px) !important;
