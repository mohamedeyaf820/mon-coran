+/* The footer's small print is the one place the app shows a Quran verse
+   translation, a reference and a source note. The root font-size is fluid
+   (15-17px), so the rem-only scales below drifted to 8.4-9.2px on a phone;
+   each one now carries a pixel floor. */
 .mp-footer-v2__verse-translation {
   overflow: hidden;
   color: var(--text-muted);
-  font-size: clamp(0.61rem, 0.9vw, 0.72rem);
+  font-size: clamp(max(0.66rem, 10px), 0.9vw, 0.78rem);
   line-height: 1.35;
   text-overflow: ellipsis;
@@ -104,5 +116,5 @@
   color: color-mix(in srgb, var(--primary) 82%, var(--text-muted));
   background: color-mix(in srgb, var(--primary) 5%, var(--bg-card));
-  font-size: 0.58rem;
+  font-size: max(0.62rem, 10px);
   font-weight: 760;
   white-space: nowrap;
@@ -126,4 +138,8 @@
   flex-direction: column;
   gap: 0.18rem;
+  /* The global `button` padding reserves 1rem on each side, which leaves a
+     22px content box in a 55px grid column and truncates "Rechercher". The
+     4-column grid and its gap already separate the buttons. */
+  padding-inline: 0;
   border: 1px solid transparent;
   border-radius: 0.72rem;
@@ -160,5 +176,9 @@
   overflow: hidden;
   color: inherit;
-  font-size: 0.58rem;
+  /* The root font-size is fluid (15-17px), so a bare rem value drifts below
+     what a phone can read: 0.58rem measured 7.8px at 280px. State the floor in
+     pixels next to the rem so it rises with the root instead of falling under
+     it. */
+  font-size: max(0.62rem, 10px);
   font-weight: 680;
   line-height: 1.1;
