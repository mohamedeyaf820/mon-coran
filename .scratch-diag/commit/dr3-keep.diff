--- a/src/styles/device-responsive.css
+++ b/src/styles/device-responsive.css
@@ -1252,4 +1253,22 @@ html body .app-root > .mp-header
 }
 
+/* Below 301px the reader header carries six 44px controls, which leaves the
+   title cell 27px at 280px: the Arabic surah ligature renders as an
+   unreadable fragment. Prev/next surah is also reachable from the sidebar's
+   surah list, so at this width the name takes the space. */
+@media (max-width: 300px) {
+  html body .app-root[data-view="reading"] > .mp-header .mp-header__nav-arrow {
+    display: none !important;
+  }
+
+  html body .app-root[data-view="reading"] > .mp-header .mp-header__nav {
+    grid-template-columns: minmax(0, 1fr) !important;
+  }
+
+  html body .app-root[data-view="reading"] > .mp-header .mp-header__title-btn {
+    width: 100% !important;
+  }
+}
