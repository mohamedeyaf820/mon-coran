+/* Below 301px the reader header holds six 44px controls, which leaves the
+   title cell 27px at 280px: the Arabic surah ligature renders as an
+   unreadable fragment. Prev/next surah is also reachable from the sidebar's
+   surah list, so at this width the name takes the space. This block sits after
+   the (max-width: 360px) reader-header contract because that one reserves the
+   two arrow tracks with `html body #root .app-root.app-root` specificity. */
+@media (max-width: 300px) {
+  html body #root .app-root.app-root[data-view="reading"] > .mp-header
+    .mp-header__nav-arrow {
+    display: none !important;
+  }
+
+  html body #root .app-root.app-root[data-view="reading"] > .mp-header
+    .mp-header__nav {
+    grid-template-columns: minmax(0, 1fr) !important;
+    width: 100% !important;
+  }
+
+  html body #root .app-root.app-root[data-view="reading"] > .mp-header
+    .mp-header__title-btn {
+    width: 100% !important;
+  }
+}
