-#sidebar[dir="rtl"],
-.sb-wrapper[dir="rtl"] {
+/* The production CSS build strips every `[dir=…]` attribute selector, so RTL
+   rules key off `.app-root[data-dir="rtl"]` — a data attribute, which survives.
+   The mirrored-edge transform only applies while the panel is the fixed sheet:
+   from 1280px it is an in-flow rail and must not be translated. */
+@media (max-width: 1279.98px) {
+  .app-root[data-dir="rtl"] #sidebar,
+  .app-root[data-dir="rtl"] .sb-wrapper {
+    left: auto;
+    right: 0;
+    transform: translateX(100%);
+  }
+}
+
+/* From 1280px only the open panel becomes the in-flow rail; a closed one is
+   still the fixed sheet, and the base rule slides it out to the left — the
+   wrong edge for a right-anchored RTL sheet, which would leave it painted over
+   the reading column. Mirror the slide-out for the closed state at every width. */
+.app-root[data-dir="rtl"] #sidebar:not(.open),
+.app-root[data-dir="rtl"] .sb-wrapper:not(.open) {
   left: auto;
   right: 0;
+  transform: translateX(100%);
+}
+
+.app-root[data-dir="rtl"] #sidebar,
+.app-root[data-dir="rtl"] .sb-wrapper {
   border-right: none;
   border-left: 1px solid var(--border);
-  transform: translateX(100%);
   box-shadow: -4px 0 24px rgba(0, 0, 0, 0.08);
 }
 
-#sidebar.open[dir="rtl"],
-.sb-wrapper.open[dir="rtl"] {
+.app-root[data-dir="rtl"] #sidebar.open,
+.app-root[data-dir="rtl"] .sb-wrapper.open {
   transform: translateX(0);
 }
