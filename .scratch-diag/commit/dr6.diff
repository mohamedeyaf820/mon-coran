   }
 
-  html body #root .app-root[data-view="reading"] .quran-display--platform
-    .qc-list-card__reference.qc-list-card__reference,
   html body #root .app-root[data-view="reading"] .quran-display--platform
     .qc-list-card__top .ayah-actions button {
@@ -1797,5 +1856,6 @@ html body #root .app-root[data-view="reading"] .quran-display--platform
   html body #root .app-root[data-view="reading"] .quran-display--platform
     .qc-list-card__reference.qc-list-card__reference {
-    font-size: 0.67rem !important;
