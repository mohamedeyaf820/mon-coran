 }
 
+/* The reference is a text target ("2:253"), not an icon: a 44px square with no
+   padding pressed the digits against both edges. Keep the 44px touch floor and
+   let the box grow with the number of digits. */
+html body #root .app-root[data-view="reading"] .quran-display--platform
