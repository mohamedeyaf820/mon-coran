+/* Touch-target floor, measured at the real root size.
+   The interface root computes to 15-17px, so a rem-authored control lands
+   below its nominal size: `h-11` measures 43.2px and `2.65rem` measures
+   39.8px. Enumerating class names does not converge - the measured sweep found
+   dozens of sub-44px pressables carrying only utility classes - so the floor is
+   stated once, in pixels, for every interactive element. `#root#root` doubles
+   the one ID every owner rule already carries, so the floor wins the
+   `!important` property war it is in; the prefix stops at `#root` because the
+   library, settings, search and reciter views render outside `.app-root` and a
+   floor that requires it silently misses them. */
+html body #root#root :is(
+    button,
+    summary,
+    [role="button"],
+    [role="tab"],
+    [role="checkbox"],
+    [role="switch"],
+    [role="menuitem"],
+    [role="option"],
+    [role="link"],
+    a[href],
+    select,
+    textarea,
+    input:not([type="hidden"], [type="checkbox"], [type="radio"], [type="range"], [type="color"], [type="file"])
+  ) {
+  min-height: max(2.75rem, 44px) !important;
+}
+
+/* Quran text surfaces take the floor back. Their word- and marker-level targets
+   are glyph-sized on purpose (WCAG 2.5.5 exempts targets inline in text), and a
+   44px box per word would break Mushaf line justification. This has to carry the
+   same doubled ID as the floor and stay below it in the file to win. */
+html body #root#root :is(
+    .qcm-line,
+    .qcm-word,
+    .qcm-ayah-marker,
+    .ayah-text,
+    .quran-text,
+    .word-item,
+    .quran-word-item,
+    .native-ayah-marker,
+    [data-word-index],
+    [data-word-position]
+  )
+  :is(button, [role="button"], [role="link"], a[href], summary) {
+  min-height: 0 !important;
+}
+
+/* The modal shell portals its content straight into `body` (ui/modal.jsx), so
+   those overlays sit outside `#root` and the rule above cannot reach them. The
+   doubled `:root` pseudo-class keeps this floor above the class-level
+   `!important` min-heights the overlays author for themselves. */
+html:root:root body > * :is(
+    button,
+    summary,
+    [role="button"],
+    [role="tab"],
+    [role="checkbox"],
+    [role="switch"],
+    [role="menuitem"],
+    [role="option"],
+    [role="link"],
+    a[href],
+    select,
+    textarea,
+    input:not([type="hidden"], [type="checkbox"], [type="radio"], [type="range"], [type="color"], [type="file"])
+  ) {
+  min-height: max(2.75rem, 44px) !important;
+}
+
+/* Icon-only controls are square: a 44px height with a 36-42px width leaves the
+   glyph target narrower than it is tall. Text buttons keep their own width. */
+html body #root#root :is(
+    .srh-play-btn,
+    .srh-info-btn,
+    .srh-fullscreen-btn,
+    .hp-card-play,
+    .search-pro__close,
+    .search-pro__submit,
+    .search-pro__voice-btn,
+    .library-close,
+    .reader-mode-nav__button,
+    .dua-open-btn-v5,
+    .home-resume-panel__secondary,
+    .mp-header__home-summary
+  ),
+  html:root:root body > * :is(
+    .search-pro__close,
+    .search-pro__submit,
+    .search-pro__voice-btn,
+    .library-close
+  ) {
+  min-width: max(2.75rem, 44px) !important;
+}
+
+/* Tailwind arbitrary text sizes are rem-authored, and this interface sets the
+   root fluidly (15px at 280px up to 17px at 1920px), so `text-[0.6rem]`
+   measures 9px on a phone and stays under 10px everywhere. The measured sweep
+   found the remaining offenders in components whose files are mid-edit
+   elsewhere, so the floor is stated here rather than in their class lists.
+   `~=` matches one whole class token, which keeps `text-[9.5px]` and the
+   named `text-xs` scale out of reach. */
+html body #root#root :is(
+  [class~="text-[0.6rem]"],
+  [class~="text-[0.64rem]"],
+  [class~="text-[0.65rem]"]
+) {
+  font-size: max(0.66rem, 10px) !important;
+}
