  "ayahs": [
    {
      "ayah_number": 1,
      "text": "tabbat yadā abī lahabin watabba"
    },
    {
      "ayah_number": 2,
      "text": "mā aghnā ʿanhu māluhu wamā kasaba"
    },
    {
      "ayah_number": 3,
      "text": "sayaṣlā nāran dhāta lahabin"
    },
    {
      "ayah_number": 4,
      "text": "wa-im'ra-atuhu ḥammālata l-ḥaṭabi"
    },
    {
      "ayah_number": 5,
      "text": "fī jīdihā ḥablun min masadin"
    }
  ]
