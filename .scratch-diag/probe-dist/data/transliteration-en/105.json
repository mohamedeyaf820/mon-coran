  "ayahs": [
    {
      "ayah_number": 1,
      "text": "alam tara kayfa faʿala rabbuka bi-aṣḥābi l-fīli"
    },
    {
      "ayah_number": 2,
      "text": "alam yajʿal kaydahum fī taḍlīlin"
    },
    {
      "ayah_number": 3,
      "text": "wa-arsala ʿalayhim ṭayran abābīla"
    },
    {
      "ayah_number": 4,
      "text": "tarmīhim biḥijāratin min sijjīlin"
    },
    {
      "ayah_number": 5,
      "text": "fajaʿalahum kaʿaṣfin makūlin"
    }
  ]
}
