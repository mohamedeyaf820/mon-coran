{
  "schema": "mushafplus-warsh-translation-fr-v1",
  "edition": "fr.montada-warsh",
  "surah_number": 86,
  "number_of_ayahs": 17,
  "ayahs": [
    {
      "ayah_number": 1,
      "hafs_numbers": [
        1
      ],
      "text": "Par le ciel et l’étoile nocturne !"
    },
    {
      "ayah_number": 2,
      "hafs_numbers": [
        2
      ],
      "text": "Et qui te fera jamais savoir ce qu’est l’étoile nocturne ?"
    },
    {
      "ayah_number": 3,
      "hafs_numbers": [
        3
      ],
      "text": "L’étoile (à la lumière) pénétrante."
    },
    {
      "ayah_number": 4,
      "hafs_numbers": [
        4
      ],
      "text": "Il n’est pas d’âme qui n’ait son (Ange) gardien."
    },
    {
      "ayah_number": 5,
      "hafs_numbers": [
        5
      ],
      "text": "Que l’homme voie donc de quoi il est créé !"
    },
    {
      "ayah_number": 6,
      "hafs_numbers": [
        6
      ],
      "text": "Il est créé d’une eau qui gicle,"
    },
    {
      "ayah_number": 7,
      "hafs_numbers": [
        7
      ],
      "text": "sortant d’entre les reins (de l’homme) et les côtes (de la femme)."
    },
    {
      "ayah_number": 8,
      "hafs_numbers": [
        8
      ],
      "text": "(Allah) est certes Capable de le ressusciter."
    },
    {
      "ayah_number": 9,
      "hafs_numbers": [
        9
      ],
      "text": "Le jour où les secrets seront révélés,"
    },
    {
      "ayah_number": 10,
      "hafs_numbers": [
        10
      ],
      "text": "il n’aura ni force ni soutien."
    },
    {
      "ayah_number": 11,
      "hafs_numbers": [
        11
      ],
      "text": "Par le ciel qui fait revenir (régulièrement la pluie) !"
    },
    {
      "ayah_number": 12,
      "hafs_numbers": [
        12
      ],
      "text": "Par la terre qui se fend (quand les graines viennent à pousser) !"
    },
    {
      "ayah_number": 13,
      "hafs_numbers": [
        13
      ],
      "text": "C’est là, certes, une parole décisive,",
      "footnotes": [
        {
          "ref": 603,
          "text": "Cette parole, c’est le Coran."
        }
      ]
    },
    {
      "ayah_number": 14,
      "hafs_numbers": [
        14
      ],
      "text": "et non point des propos frivoles."
    },
    {
      "ayah_number": 15,
      "hafs_numbers": [
        15
      ],
      "text": "Ils rusent de leur meilleure ruse,"
    },
    {
      "ayah_number": 16,
      "hafs_numbers": [
        16
      ],
      "text": "Et Je ruse de Ma meilleure ruse."
    },
    {
      "ayah_number": 17,
      "hafs_numbers": [
        17
      ],
      "text": "Accorde donc un délai aux mécréants, donne-leur répit pour quelque temps."
    }
  ]
}
