{
  "schema": "mushafplus-warsh-translation-en-v1",
  "edition": "en.pickthall-warsh",
  "surah_number": 90,
  "number_of_ayahs": 20,
  "ayahs": [
    {
      "ayah_number": 1,
      "hafs_numbers": [
        1
      ],
      "text": "Nay, I swear by this city -"
    },
    {
      "ayah_number": 2,
      "hafs_numbers": [
        2
      ],
      "text": "And thou art an indweller of this city -"
    },
    {
      "ayah_number": 3,
      "hafs_numbers": [
        3
      ],
      "text": "And the begetter and that which he begat,"
    },
    {
      "ayah_number": 4,
      "hafs_numbers": [
        4
      ],
      "text": "We verily have created man in an atmosphere:"
    },
    {
      "ayah_number": 5,
      "hafs_numbers": [
        5
      ],
      "text": "Thinketh he that none hath power over him?"
    },
    {
      "ayah_number": 6,
      "hafs_numbers": [
        6
      ],
      "text": "And he saith: I have destroyed vast wealth:"
    },
    {
      "ayah_number": 7,
      "hafs_numbers": [
        7
      ],
      "text": "Thinketh he that none beholdeth him?"
    },
    {
      "ayah_number": 8,
      "hafs_numbers": [
        8
      ],
      "text": "Did We not assign unto him two eyes"
    },
    {
      "ayah_number": 9,
      "hafs_numbers": [
        9
      ],
      "text": "And a tongue and two lips,"
    },
    {
      "ayah_number": 10,
      "hafs_numbers": [
        10
      ],
      "text": "And guide him to the parting of the mountain ways?"
    },
    {
      "ayah_number": 11,
      "hafs_numbers": [
        11
      ],
      "text": "But he hath not attempted the Ascent -"
    },
    {
      "ayah_number": 12,
      "hafs_numbers": [
        12
      ],
      "text": "Ah, what will convey unto thee what the Ascent is! -"
    },
    {
      "ayah_number": 13,
      "hafs_numbers": [
        13
      ],
      "text": "(It is) to free a slave,"
    },
    {
      "ayah_number": 14,
      "hafs_numbers": [
        14
      ],
      "text": "And to feed in the day of hunger."
    },
    {
      "ayah_number": 15,
      "hafs_numbers": [
        15
      ],
      "text": "An orphan near of kin,"
    },
    {
      "ayah_number": 16,
      "hafs_numbers": [
        16
      ],
      "text": "Or some poor wretch in misery,"
    },
    {
      "ayah_number": 17,
      "hafs_numbers": [
        17
      ],
      "text": "And to be of those who believe and exhort one another to perseverance and exhort one another to pity."
    },
    {
      "ayah_number": 18,
      "hafs_numbers": [
        18
      ],
      "text": "Their place will be on the right hand."
    },
    {
      "ayah_number": 19,
      "hafs_numbers": [
        19
      ],
      "text": "But those who disbelieve Our revelations, their place will be on the left hand."
    },
    {
      "ayah_number": 20,
      "hafs_numbers": [
        20
      ],
      "text": "Fire will be an awning over them."
    }
  ]
}
