{
  "schema": "mushafplus-transliteration-en-hafs-v1",
  "edition": "en.qurancom-wordbyword",
  "surah_number": 55,
  "number_of_ayahs": 78,
  "ayahs": [
    {
      "ayah_number": 1,
      "text": "al-raḥmānu"
    },
    {
      "ayah_number": 2,
      "text": "ʿallama l-qur'āna"
    },
    {
      "ayah_number": 3,
      "text": "khalaqa l-insāna"
    },
    {
      "ayah_number": 4,
      "text": "ʿallamahu l-bayāna"
    },
    {
      "ayah_number": 5,
      "text": "al-shamsu wal-qamaru biḥus'bānin"
    },
    {
      "ayah_number": 6,
      "text": "wal-najmu wal-shajaru yasjudāni"
    },
    {
      "ayah_number": 7,
      "text": "wal-samāa rafaʿahā wawaḍaʿa l-mīzāna"
    },
    {
      "ayah_number": 8,
      "text": "allā taṭghaw fī l-mīzāni"
    },
    {
      "ayah_number": 9,
      "text": "wa-aqīmū l-wazna bil-qis'ṭi walā tukh'sirū l-mīzāna"
    },
    {
      "ayah_number": 10,
      "text": "wal-arḍa waḍaʿahā lil'anāmi"
    },
    {
      "ayah_number": 11,
      "text": "fīhā fākihatun wal-nakhlu dhātu l-akmāmi"
    },
    {
      "ayah_number": 12,
      "text": "wal-ḥabu dhū l-ʿaṣfi wal-rayḥānu"
    },
    {
      "ayah_number": 13,
      "text": "fabi-ayyi ālāi rabbikumā tukadhibāni"
    },
    {
      "ayah_number": 14,
      "text": "khalaqa l-insāna min ṣalṣālin kal-fakhāri"
    },
    {
      "ayah_number": 15,
      "text": "wakhalaqa l-jāna min mārijin min nārin"
    },
    {
      "ayah_number": 16,
      "text": "fabi-ayyi ālāi rabbikumā tukadhibāni"
    },
    {
      "ayah_number": 17,
      "text": "rabbu l-mashriqayni warabbu l-maghribayni"
    },
    {
      "ayah_number": 18,
      "text": "fabi-ayyi ālāi rabbikumā tukadhibāni"
    },
    {
      "ayah_number": 19,
      "text": "maraja l-baḥrayni yaltaqiyāni"
    },
    {
      "ayah_number": 20,
      "text": "baynahumā barzakhun lā yabghiyāni"
    },
    {
      "ayah_number": 21,
      "text": "fabi-ayyi ālāi rabbikumā tukadhibāni"
    },
    {
      "ayah_number": 22,
      "text": "yakhruju min'humā l-lu'lu-u wal-marjānu"
    },
    {
      "ayah_number": 23,
      "text": "fabi-ayyi ālāi rabbikumā tukadhibāni"
    },
    {
      "ayah_number": 24,
      "text": "walahu l-jawāri l-munshaātu fī l-baḥri kal-aʿlāmi"
    },
    {
      "ayah_number": 25,
      "text": "fabi-ayyi ālāi rabbikumā tukadhibāni"
    },
    {
      "ayah_number": 26,
      "text": "kullu man ʿalayhā fānin"
    },
    {
      "ayah_number": 27,
      "text": "wayabqā wajhu rabbika dhū l-jalāli wal-ik'rāmi"
    },
    {
      "ayah_number": 28,
      "text": "fabi-ayyi ālāi rabbikumā tukadhibāni"
    },
    {
      "ayah_number": 29,
      "text": "yasaluhu man fī l-samāwāti wal-arḍi kulla yawmin huwa fī shanin"
    },
    {
      "ayah_number": 30,
      "text": "fabi-ayyi ālāi rabbikumā tukadhibāni"
    },
    {
      "ayah_number": 31,
      "text": "sanafrughu lakum ayyuha l-thaqalāni"
    },
    {
      "ayah_number": 32,
      "text": "fabi-ayyi ālāi rabbikumā tukadhibāni"
    },
    {
      "ayah_number": 33,
      "text": "yāmaʿshara l-jini wal-insi ini is'taṭaʿtum an tanfudhū min aqṭāri l-samāwāti wal-arḍi fa-unfudhū lā tanfudhūna illā bisul'ṭānin"
    },
    {
      "ayah_number": 34,
      "text": "fabi-ayyi ālāi rabbikumā tukadhibāni"
    },
    {
      "ayah_number": 35,
      "text": "yur'salu ʿalaykumā shuwāẓun min nārin wanuḥāsun falā tantaṣirāni"
    },
    {
      "ayah_number": 36,
      "text": "fabi-ayyi ālāi rabbikumā tukadhibāni"
    },
    {
      "ayah_number": 37,
      "text": "fa-idhā inshaqqati l-samāu fakānat wardatan kal-dihāni"
    },
    {
      "ayah_number": 38,
      "text": "fabi-ayyi ālāi rabbikumā tukadhibāni"
    },
    {
      "ayah_number": 39,
      "text": "fayawma-idhin lā yus'alu ʿan dhanbihi insun walā jānnun"
    },
    {
      "ayah_number": 40,
      "text": "fabi-ayyi ālāi rabbikumā tukadhibāni"
    },
    {
      "ayah_number": 41,
      "text": "yuʿ'rafu l-muj'rimūna bisīmāhum fayu'khadhu bil-nawāṣī wal-aqdāmi"
    },
    {
      "ayah_number": 42,
      "text": "fabi-ayyi ālāi rabbikumā tukadhibāni"
    },
    {
      "ayah_number": 43,
      "text": "hādhihi jahannamu allatī yukadhibu bihā l-muj'rimūna"
    },
    {
      "ayah_number": 44,
      "text": "yaṭūfūna baynahā wabayna ḥamīmin ānin"
    },
    {
      "ayah_number": 45,
      "text": "fabi-ayyi ālāi rabbikumā tukadhibāni"
    },
    {
      "ayah_number": 46,
      "text": "waliman khāfa maqāma rabbihi jannatāni"
    },
    {
      "ayah_number": 47,
      "text": "fabi-ayyi ālāi rabbikumā tukadhibāni"
    },
    {
      "ayah_number": 48,
      "text": "dhawātā afnānin"
    },
    {
      "ayah_number": 49,
      "text": "fabi-ayyi ālāi rabbikumā tukadhibāni"
    },
    {
      "ayah_number": 50,
      "text": "fīhimā ʿaynāni tajriyāni"
    },
    {
      "ayah_number": 51,
      "text": "fabi-ayyi ālāi rabbikumā tukadhibāni"
    },
    {
      "ayah_number": 52,
      "text": "fīhimā min kulli fākihatin zawjāni"
    },
    {
      "ayah_number": 53,
      "text": "fabi-ayyi ālāi rabbikumā tukadhibāni"
    },
    {
      "ayah_number": 54,
      "text": "muttakiīna ʿalā furushin baṭāinuhā min is'tabraqin wajanā l-janatayni dānin"
    },
    {
      "ayah_number": 55,
      "text": "fabi-ayyi ālāi rabbikumā tukadhibāni"
    },
    {
      "ayah_number": 56,
      "text": "fīhinna qāṣirātu l-ṭarfi lam yaṭmith'hunna insun qablahum walā jānnun"
    },
    {
      "ayah_number": 57,
      "text": "fabi-ayyi ālāi rabbikumā tukadhibāni"
    },
    {
      "ayah_number": 58,
      "text": "ka-annahunna l-yāqūtu wal-marjānu"
    },
    {
      "ayah_number": 59,
      "text": "fabi-ayyi ālāi rabbikumā tukadhibāni"
    },
    {
      "ayah_number": 60,
      "text": "hal jazāu l-iḥ'sāni illā l-iḥ'sānu"
    },
    {
      "ayah_number": 61,
      "text": "fabi-ayyi ālāi rabbikumā tukadhibāni"
    },
    {
      "ayah_number": 62,
      "text": "wamin dūnihimā jannatāni"
    },
    {
      "ayah_number": 63,
      "text": "fabi-ayyi ālāi rabbikumā tukadhibāni"
    },
    {
      "ayah_number": 64,
      "text": "mud'hāmmatāni"
    },
    {
      "ayah_number": 65,
      "text": "fabi-ayyi ālāi rabbikumā tukadhibāni"
    },
    {
      "ayah_number": 66,
      "text": "fīhimā ʿaynāni naḍḍākhatāni"
    },
    {
      "ayah_number": 67,
      "text": "fabi-ayyi ālāi rabbikumā tukadhibāni"
    },
    {
      "ayah_number": 68,
      "text": "fīhimā fākihatun wanakhlun warummānun"
    },
    {
      "ayah_number": 69,
      "text": "fabi-ayyi ālāi rabbikumā tukadhibāni"
    },
    {
      "ayah_number": 70,
      "text": "fīhinna khayrātun ḥisānun"
    },
    {
      "ayah_number": 71,
      "text": "fabi-ayyi ālāi rabbikumā tukadhibāni"
    },
    {
      "ayah_number": 72,
      "text": "ḥūrun maqṣūrātun fī l-khiyāmi"
    },
    {
      "ayah_number": 73,
      "text": "fabi-ayyi ālāi rabbikumā tukadhibāni"
    },
    {
      "ayah_number": 74,
      "text": "lam yaṭmith'hunna insun qablahum walā jānnun"
    },
    {
      "ayah_number": 75,
      "text": "fabi-ayyi ālāi rabbikumā tukadhibāni"
    },
    {
      "ayah_number": 76,
      "text": "muttakiīna ʿalā rafrafin khuḍ'rin waʿabqariyyin ḥisānin"
    },
    {
      "ayah_number": 77,
      "text": "fabi-ayyi ālāi rabbikumā tukadhibāni"
    },
    {
      "ayah_number": 78,
      "text": "tabāraka us'mu rabbika dhī l-jalāli wal-ik'rāmi"
    }
  ]
}
